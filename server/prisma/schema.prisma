// GupShup Prisma schema — PostgreSQL required. No MongoDB.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FollowRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum ConversationType {
  DIRECT
  GROUP
}

enum Gender {
  MALE
  FEMALE
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(80)
  username     String   @unique @db.VarChar(30)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @db.VarChar(255)
  gender       Gender    @default(MALE)
  bio          String?  @db.VarChar(300)
  avatarUrl    String?  @db.VarChar(500)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sentRequests     FollowRequest[]      @relation("SentRequests")
  receivedRequests FollowRequest[]      @relation("ReceivedRequests")
  following        Follow[]             @relation("FollowerLinks")
  followers        Follow[]             @relation("FollowingLinks")
  memberships      ConversationMember[]
  messages         Message[]

  @@index([username])
  @@index([name])
}

model FollowRequest {
  id          String              @id @default(uuid()) @db.Uuid
  senderId    String              @db.Uuid
  receiverId  String              @db.Uuid
  status      FollowRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  respondedAt DateTime?

  sender   User @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  // One row per unordered pair direction. Re-request after REJECTED/CANCELLED
  // reuses the same row via status transition back to PENDING (see service).
  @@unique([senderId, receiverId])
  @@index([receiverId, status])
  @@index([senderId, status])
}

model Follow {
  followerId  String   @db.Uuid
  followingId String   @db.Uuid
  createdAt   DateTime @default(now())

  follower  User @relation("FollowerLinks", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("FollowingLinks", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
  @@index([followerId])
}

model Conversation {
  id        String           @id @default(uuid()) @db.Uuid
  type      ConversationType @default(DIRECT)
  // For DIRECT: canonical "smallerUuid:largerUuid" — prevents duplicate 1:1 threads.
  pairKey   String?          @unique
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  members  ConversationMember[]
  messages Message[]

  @@index([updatedAt])
}

model ConversationMember {
  conversationId String   @db.Uuid
  userId         String   @db.Uuid
  joinedAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id              String    @id @default(uuid()) @db.Uuid
  conversationId  String    @db.Uuid
  senderId        String    @db.Uuid
  content         String    @db.VarChar(2000)
  // Idempotency key for socket retries: client generates UUID per message.
  clientMessageId String?   @unique
  createdAt       DateTime  @default(now())
  editedAt        DateTime?
  deletedAt       DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
}
